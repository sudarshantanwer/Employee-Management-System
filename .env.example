# Application
APP_NAME=Employee Management System
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# MongoDB
MONGO_URI=mongodb://mongodb:27017
DATABASE_NAME=employee_management
# MongoDB Compass URI (local dev): mongodb://localhost:27017/employee_management

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-use-a-strong-random-secret-key
JWT_REFRESH_SECRET_KEY=change-me-use-a-different-strong-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
